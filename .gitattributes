# 统一按文本处理，避免 Windows / macOS / Linux 之间反复产生整文件 diff
* text=auto eol=lf

*.kt       text eol=lf
*.kts      text eol=lf
*.xml      text eol=lf
*.md       text eol=lf
*.toml     text eol=lf
*.properties text eol=lf
*.pro      text eol=lf
*.js       text eol=lf
*.css      text eol=lf
*.html     text eol=lf

# gradlew 是 shell 脚本，必须保持 LF，否则在 Linux/macOS 上跑不起来
gradlew     text eol=lf
gradlew.bat text eol=crlf

*.jar      binary
*.apk      binary
*.png      binary
*.jks      binary
*.keystore binary
